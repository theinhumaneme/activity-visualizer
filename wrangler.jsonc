{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "activity-visualizer",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "binding": "ASSETS",
    // React SPA: unknown paths fall back to index.html; /api/* always hits the Worker.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
  // Optional secret (not committed): MAPTILER_KEY — switches satellite imagery to MapTiler
  // (the key reaches the browser; restrict it to your domain in the MapTiler dashboard).
  //   Local: put it in .dev.vars   Production: npx wrangler secret put MAPTILER_KEY
}
